def _node_config(node):
    """(config, api) for a node's button callback.

    The node's API Key parm wins over config.toml when it is set, so a user can
    drive a second account without editing the config file.
    """
    cfg = rpcfg.load()
    parm = node.parm("rpfarm_apikey")
    api_key = (parm.evalAsString() if parm else "") or cfg.api_key
    return cfg, RunPodAPI(api_key)


def _set_text(node, parm_name, text):
    parm = node.parm(parm_name)
    if parm is not None:
        parm.set(text)


def _report(node, parm_name, text):
    _set_text(node, parm_name, text)
    print("[rpfarm] " + text, flush=True)


def onKillAll(kwargs):
    """Terminate every GPU pod belonging to this user, cook or no cook."""
    node = kwargs["node"]
    try:
        cfg, api = _node_config(node)
        orphans = rppods.find_orphans(api, cfg.user)
        rppods.terminate_all(api, [p["id"] for p in orphans])
        _report(
            node,
            "rpfarm_status_text",
            "Killed {} pod(s): {}".format(
                len(orphans), ", ".join(p.get("name", p["id"]) for p in orphans) or "-"
            ),
        )
    except (rpcfg.ConfigError, RunPodError) as e:
        _report(node, "rpfarm_status_text", "Kill all failed: {}".format(e))


def onSyncLedger(kwargs):
    """Pull ledger records off the volume into ~/.rpfarm/ledger."""
    node = kwargs["node"]
    try:
        cfg, api = _node_config(node)
        token = rpcfg.session_token()
        pubkey = _read_pubkey(cfg)
        pod = rppods.ensure_sync_pod(api, cfg, token, pubkey, log=print)
        ip, port = pod_public_endpoint(pod, 22)
        target = rpsync.SftpTarget(host=ip, port=port, key_path=cfg.ssh_key_path)
        local = str(rpcfg.home() / "ledger")
        os.makedirs(local, exist_ok=True)
        stats = rpsync.rclone_copy_dir(
            local, target, "down", cfg.rclone_path, remote_root="/workspace/ledger"
        )
        _report(
            node,
            "rpfarm_status_text",
            "Ledger synced: {} file(s), {} bytes in {:.1f}s -> {}".format(
                stats.files, stats.bytes, stats.seconds, local
            ),
        )
    except (rpcfg.ConfigError, RunPodError, rpsync.SyncError, OSError, TimeoutError) as e:
        _report(node, "rpfarm_status_text", "Ledger sync failed: {}".format(e))


def _volume_exec(node, command, timeout_s=300):
    """Run a housekeeping command on the sync pod, returning its stdout."""
    cfg, api = _node_config(node)
    token = rpcfg.session_token()
    pod = rppods.ensure_sync_pod(api, cfg, token, _read_pubkey(cfg), log=print)
    client = WorkerClient(pod["id"], token)
    result = client.exec(command, timeout_s=timeout_s)
    if result.get("exit_code") != 0:
        raise RuntimeError(result.get("stderr") or "exit {}".format(result.get("exit_code")))
    return result.get("stdout", "")


def onVolumeRefresh(kwargs):
    """List the volume's zones, per-project usage, and totals (Task 12 `ls`).

    Ruling R27: passes ``--volume-size-gb`` (RunPod's own
    ``get_volume``, cached via ``rpfarm.packages.get_volume_size_gb``) so
    the percent-full figure below is never derived from the pod's own
    ``shutil.disk_usage`` -- confirmed live to report the backing storage
    pool's capacity, not the network volume's real size (a real 50GB
    volume read back as ~2.14 PiB).
    """
    node = kwargs["node"]
    try:
        cfg, api = _node_config(node)
        volume_size_gb = rppkg.get_volume_size_gb(api, cfg)
        command = "{} ls".format(_HOUSEKEEPING)
        if volume_size_gb:
            command += " --volume-size-gb {}".format(volume_size_gb)
        out = _volume_exec(node, command)
        info = json.loads(out or "{}")

        lines = ["Zones:"]
        for zone, nbytes in info.get("zones", {}).items():
            lines.append("{:>10.2f} GB  {}".format(nbytes / 2**30, zone))

        lines.append("")
        lines.append("Projects:")
        projects = info.get("projects", [])
        if not projects:
            lines.append("  (none)")
        for p in projects:
            pending = "  [pending download]" if p.get("outputs_pending") else ""
            lines.append(
                "{:>10.2f} GB  {}/{}{}".format(
                    p.get("bytes", 0) / 2**30, p.get("user"), p.get("project"), pending
                )
            )

        volume = info.get("volume", {})
        used = volume.get("used") or 0
        total = volume.get("total")
        lines.append("")
        if total:
            pct = volume.get("used_pct")
            if pct is None:
                pct = 100.0 * used / total
            lines.append(
                "Volume: {:.2f} / {:.2f} GB ({:.0f}% full)".format(used / 2**30, total / 2**30, pct)
            )
        else:
            # Ruling R27: no real size available (get_volume failed/uncached)
            # -- show used bytes alone rather than a bogus %, and never fall
            # back to shutil.disk_usage's backing-pool number.
            lines.append("Volume: {:.2f} GB used (total unknown -- {})".format(
                used / 2**30, volume.get("note", "RunPod get_volume unavailable")))
        if info.get("partial"):
            # Ruling R26: ls serves cached sizes and re-measures stale ones
            # within a shared time budget -- if that budget ran out, some
            # numbers above are stale rather than missing. Rerunning
            # (Refresh again) re-measures whatever is still stale.
            lines.append("")
            lines.append("(partial: some sizes are cached/stale -- click Refresh again to retry)")
        _set_text(node, "rpfarm_volume_text", "\n".join(lines))
    except Exception as e:  # a button must never raise into the UI
        _set_text(node, "rpfarm_volume_text", "Refresh failed: {}".format(e))


# Accepted 'Target' shapes for onVolumeDelete, each routed through a guarded
# housekeeping command instead of a raw `rm -rf` -- see that function.
_VOLUME_DELETE_PROJECT_PREFIX = "/workspace/projects/"
_VOLUME_DELETE_HOUDINI_PREFIX = "/workspace/houdini/"


def onVolumeDelete(kwargs):
    """Delete one project or Houdini version from the volume (guarded, confirms in the UI).

    'Target' must be ``/workspace/projects/<user>/<project>`` or
    ``/workspace/houdini/<version>`` -- routed through housekeeping's `rm`
    (Task 12) / `houdini rm`, which refuse `/workspace/houdini`,
    `/workspace/ledger` and `/workspace/.rpfarm` outright. This replaces
    the old raw `rm -rf`, which only blocked the top-level zone itself and
    could still delete e.g. a path one level into `/workspace/ledger/`.
    """
    node = kwargs["node"]
    target = node.parm("rpfarm_volume_target").evalAsString().strip()
    if not target:
        _set_text(node, "rpfarm_volume_text", "Set 'Target' to the path to delete.")
        return
    # posixpath, not os.path: the target is a path on the Linux pod, and this
    # callback also runs on Windows.
    target = posixpath.normpath(target).replace("\\", "/")

    if target.startswith(_VOLUME_DELETE_PROJECT_PREFIX):
        rel = target[len(_VOLUME_DELETE_PROJECT_PREFIX):].strip("/")
        parts = rel.split("/")
        if len(parts) != 2 or not all(parts):
            _set_text(
                node, "rpfarm_volume_text",
                "Refusing {!r}: expected /workspace/projects/<user>/<project>.".format(target))
            return
        # The UI confirmation below stands in for --force: an artist who
        # explicitly names a project and confirms the dialog has already
        # made the call that any pending download is expendable.
        user_project = "{}/{}".format(parts[0], parts[1])
        command = "{} rm {} --force".format(_HOUSEKEEPING, _shquote(user_project))
    elif target.startswith(_VOLUME_DELETE_HOUDINI_PREFIX):
        version = target[len(_VOLUME_DELETE_HOUDINI_PREFIX):].strip("/")
        if not version or "/" in version:
            _set_text(
                node, "rpfarm_volume_text",
                "Refusing {!r}: expected /workspace/houdini/<version>.".format(target))
            return
        command = "{} houdini rm {}".format(_HOUSEKEEPING, _shquote(version))
    else:
        _set_text(
            node, "rpfarm_volume_text",
            "Refusing {!r}: must be /workspace/projects/<user>/<project> or "
            "/workspace/houdini/<version>.".format(target))
        return

    import hou

    if hou.isUIAvailable():
        if hou.ui.displayMessage(
            "Permanently delete {} from the network volume?".format(target),
            buttons=("Delete", "Cancel"),
            default_choice=1,
            close_choice=1,
            severity=hou.severityType.Warning,
        ):
            return
    try:
        out = _volume_exec(node, command)
        result = json.loads(out or "{}")
        if result.get("ok"):
            _set_text(node, "rpfarm_volume_text", "Deleted {}".format(target))
        else:
            _set_text(
                node, "rpfarm_volume_text",
                "Delete refused: {}".format(result.get("error", "unknown reason")))
    except Exception as e:
        _set_text(node, "rpfarm_volume_text", "Delete failed: {}".format(e))


def onVolumeGrow(kwargs):
    """Grow the network volume by 'Grow By (GB)'."""
    node = kwargs["node"]
    try:
        cfg, api = _node_config(node)
        vol_parm = node.parm("rpfarm_networkvolumeid")
        vid = (vol_parm.evalAsString() if vol_parm else "") or cfg.volume_id
        grow = node.parm("rpfarm_volume_growgb").evalAsInt()
        if grow <= 0:
            _set_text(node, "rpfarm_volume_text", "Set 'Grow By (GB)' above zero.")
            return
        current = int((api.get_volume(vid) or {}).get("size") or 0)
        new_size = current + grow
        api.resize_volume(vid, new_size)
        _set_text(
            node,
            "rpfarm_volume_text",
            "Volume {} resized {} GB -> {} GB".format(vid, current, new_size),
        )
    except Exception as e:
        _set_text(node, "rpfarm_volume_text", "Grow failed: {}".format(e))


def _shquote(value):
    """POSIX single-quote a value for interpolation into a shell command
    string sent to `_volume_exec`/`WorkerClient.exec` (the pod runs these
    through a shell, e.g. `mkdir -p ... && touch ...`). Restored after
    review: onVolumeDelete interpolates artist-typed path components
    (`parts[0]`/`parts[1]`/`version`) unquoted, which is shell injection,
    not just a style nit -- a Target like
    `/workspace/projects/may/x; rm -rf /workspace/ledger` fails the
    "well-formed <user>/<project>" check (an extra '/'), but
    `/workspace/projects/may/x; touch pwned` does not.
    """
    return "'" + str(value).replace("'", "'\"'\"'") + "'"


def _read_pubkey(cfg):
    """Contents of the artist's public SSH key, for the pods' authorized_keys."""
    path = cfg.ssh_key_path + ".pub"
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except OSError as e:
        raise CookError(
            "Cannot read the SSH public key at {} ({}). Run `rpfarm setup`, or "
            "`ssh-keygen -t ed25519 -N '' -f {}`.".format(path, e, cfg.ssh_key_path)
        ) from e


class RunPodFarmScheduler(EventDispatchMixin, SimpleMQSchedulerMixin, PyScheduler):
    """PDG scheduler backed by RunPod pods.

    One CPU "sync" pod per user carries sshd (for rclone), the PDG mqserver for
    the current cook, and housekeeping. GPU pods are created per cook, run the
    same worker daemon, and are terminated when they go idle or when the cook
    ends.
    """

    def __init__(self, scheduler, name):
        PyScheduler.__init__(self, scheduler, name)
        SimpleMQSchedulerMixin.__init__(self)
        EventDispatchMixin.__init__(self)

        # The underscore-separated prefix used on all job parm names
        self.parmprefix = "rpfarm"

        self._verbose = 0
        self._reset_cook_state()

    def _reset_cook_state(self):
        self._cfg = None
        self._api = None
        self._token = ""
        self._pubkey = ""
        self._project = ""
        self._cook_id = ""
        self._job_dir = ""
        self._remote_project = ""
        self._gpu_list = []
        self._dispatcher = rpdispatch.Dispatcher(1)
        self._clients = {}
        self._work_items = {}
        self._sync_pod = None
        self._sync_client = None
        self._sftp = None
        self._sync_queue = []
        self._ledger_path = ""
        self._pathmap = {}
        self._cost_tracker = {}
        self._render_times = []
        self._last_status_update = 0.0
        self._last_health_poll = {}
        self._last_task_poll = {}
        self._killed_over_budget = False
        self._last_pod_error = None
        self._last_scale_failure = 0.0
        # Ruling R25: set by _mirror_ledger_to_volume in onStopCook, read
        # by _update_status_text (before this reset runs -- see the call
        # order in onStopCook) to tell the artist when the journal didn't
        # make it to the volume this cook.
        self._ledger_mirror_note = None

    @classmethod
    def templateName(cls):
        return "runpodfarmscheduler"

    @classmethod
    def templateBody(cls):
        return json.dumps({
            "name": "runpodfarmscheduler",
            "parameters": [
                # -- RunPod --
                {"name": "rpfarm_apikey", "type": "String", "tag": ["pdg::scheduler"]},
                {"name": "rpfarm_project", "type": "String"},
                {"name": "rpfarm_gpulist", "type": "String"},
                {"name": "rpfarm_templateid", "type": "String"},
                {"name": "rpfarm_networkvolumeid", "type": "String"},
                {"name": "rpfarm_datacenter", "type": "String"},
                {"name": "rpfarm_verbose", "type": "Integer"},
                # -- Scaling --
                {"name": "rpfarm_minpods", "type": "Integer"},
                {"name": "rpfarm_maxpods", "type": "Integer"},
                {"name": "rpfarm_slots", "type": "Integer"},
                {"name": "rpfarm_idletimeout", "type": "Integer"},
                {"name": "rpfarm_syncidle", "type": "Integer"},
                # -- Budget --
                {"name": "rpfarm_maxcost", "type": "Float"},
                {"name": "rpfarm_minbalance", "type": "Float"},
                # -- Outputs --
                {"name": "rpfarm_downloadoutputs", "type": "Integer"},
                # -- Status --
                # Read-only display, written by _update_status_text through the
                # TOP node (see _setStatusText for why not setParameter).
                {"name": "rpfarm_status_text", "type": "String"},
                # -- Paths --
                {"name": "rpfarm_overrideremoteworkingdir", "type": "Integer"},
                {"name": "rpfarm_remoteworkingdir", "type": "String"},
                # -- Job Parms --
                {"name": "rpfarm_pretaskcmd", "type": "String"},
                {"name": "rpfarm_posttaskcmd", "type": "String"},
                # -- Submit as Job --
                {"name": "submitjobfile", "type": "Integer"},
            ]
        })

    # -------------------------------------------------------------------------
    # Logging
    # -------------------------------------------------------------------------

    def _verboseLog(self, *args, **kwargs):
        """Mirror PDG's verbose log to stdout.

        The PDG log only shows up in Houdini's own console; a headless hython
        cook (the smoke test, `rpfarm smoke`, CI) needs these lines on stdout --
        including "Got PDG MQ server info: ..." which SimpleMQSchedulerMixin
        emits through this method.
        """
        if self._verbose or "force" in kwargs:
            print("[rpfarm] " + " ".join(str(a) for a in args), flush=True)
        PyScheduler._verboseLog(self, *args, **kwargs)

    def _log(self, message):
        """A cook milestone: always shown, verbose or not."""
        print("[rpfarm] " + str(message), flush=True)

    # -------------------------------------------------------------------------
    # Application binary paths
    # -------------------------------------------------------------------------

    def _pythonBin(self, work_item):
        """Path to python3 on the pod (the __PDG_PYTHON__ token)."""
        return "/usr/bin/python3"

    def _hythonBin(self, work_item):
        """Path to hython on the pod (the __PDG_HYTHON__ token).

        Houdini lives on the shared network volume under a per-version
        directory, matching HFS as set by pod/entrypoint.sh.
        """
        version = self._cfg.houdini_version if self._cfg else "22.0.393"
        return "/workspace/houdini/{}/bin/hython".format(version)

    def applicationBin(self, name, work_item):
        """[virtual] Returns the path to the given application."""
        if name == "python":
            return self._pythonBin(work_item)
        elif name == "hython":
            return self._hythonBin(work_item)

    # -------------------------------------------------------------------------
    # Event dispatch override
    # -------------------------------------------------------------------------

    def execEvent(self, event):
        """Override of EventDispatchMixin. Print all events when verbose."""
        if self._verbose > 0:
            self._verboseLog(repr(event))
        return EventDispatchMixin.execEvent(self, event)

    # -------------------------------------------------------------------------
    # Token expansion and environment preparation
    # -------------------------------------------------------------------------

    def expandCommandTokens(self, item_command, work_item=None):
        """
        Expands special tokens in a platform-independent path string to a
        platform-specific path string on the remote machine.
        """
        if work_item:
            item_command = item_command.replace(
                "__PDG_ITEM_NAME__", work_item.name)
            item_command = item_command.replace(
                "__PDG_ITEM_ID__", str(work_item.id))

        item_command = item_command.replace(
            "__PDG_PYTHON__", self.applicationBin("python", work_item))

        item_command = item_command.replace(
            "__PDG_HYTHON__", self.applicationBin("hython", work_item))

        item_command = item_command.replace(
            "__PDG_RESULT_SERVER__", self.workItemResultServerAddr())

        item_command = item_command.replace(
            "__PDG_SHARED_TEMP__", self.tempDir(False))
        item_command = item_command.replace(
            "__PDG_TEMP__", self.tempDir(False))

        item_command = item_command.replace(
            "__PDG_SCRIPTDIR__", self.scriptDir(False))

        item_command = item_command.replace(
            "__PDG_DIR__", self.workingDir(False))
        item_command = item_command.replace(
            "__PDG_SHARED_ROOT__", self.workingDir(False))

        # $HFS on the pod, not on the artist's machine.
        item_command = item_command.replace(
            "__PDG_HFS__", "/workspace/houdini/{}".format(
                self._cfg.houdini_version if self._cfg else ""))

        return item_command

    def _prepareTaskEnv(self, node, work_item):
        """
        Prepares the environment dictionary that the task should run in.
        The task environment includes variables describing the remote machine's
        working directory structure, the current work item, and the MQ server
        configuration.
        """
        # The base environment is the initial environment for the work item,
        # with values inherited from the existing environment if indicated.
        # It excludes environment variables with names beginning with "HOUDINI_"
        # and values containing the $HFS path, as these are potentially
        # platform-specific.
        task_env = self.resolveBaseEnvironment(self.parmprefix, node, work_item)

        task_env.update({
            "PDG_RESULT_SERVER": self.workItemResultServerAddr(),
            "PDG_DIR": self.workingDir(False),
            "PDG_TEMP": self.tempDir(False),
            "PDG_SCRIPTDIR": self.scriptDir(False),
            "PDG_PYATTRIB_LOADER": TypeRegistry.types().pySerializationModule,
            "PDG_RELEASE_SLOT_ON_POLL": "0",
        })

        if work_item:
            task_env.update({
                "PDG_ITEM_NAME": work_item.name,
                "PDG_ITEM_LABEL": work_item.label,
                "PDG_ITEM_ID": str(work_item.id),
                "PDG_ITEM_DATA_SOURCE": str(int(self.workItemDataSource)),
                "PDG_INDEX": str(work_item.index),
                # PDGNET configuration
                "PDG_HTTP_PORT": str(self.mqinfo.mq_httpport),
                "PDG_JOBUSE_PDGNET": "1",
                "PDG_RESULT_CLIENT_ID": self.mqinfo.client_id,
            })

        if self._verbose:
            task_env["PDG_VERBOSE"] = "1"

        # The user can override this behavior by explicitly setting the env var
        # in a pdg::scheduler or item environment
        hmt = self.initHoudiniMaxThreads(work_item, self.parmprefix, None)
        if hmt is not None:
            task_env["HOUDINI_MAXTHREADS"] = str(hmt)

        if work_item:
            # Check the exported attributes
            env_map = work_item.environment
            setmap = {}
            for var, val in list(env_map.items()):
                var = var.strip()
                setmap[var] = str(val)
            task_env.update(setmap)

        # Writes the PDG path map info to the environment. The entries this
        # scheduler registered in onStartCook are part of the global path map,
        # so they come out of here automatically.
        self.resolvePathMapping(task_env)
        self._ensurePathMapEnv(task_env)

        # Resolves the environment specified in the Job Parms scheduler section
        add_env, remove_env = self.resolveEnvParams(
            self.parmprefix, work_item, True)

        # Process any removals
        for k in remove_env:
            if k in task_env:
                del task_env[k]
        task_env.update(add_env)

        return task_env

    def _ensurePathMapEnv(self, task_env):
        """Backstop for $PDG_PATHMAP.

        resolvePathMapping serialises the *global* PDG path map, which is where
        _registerPathMap put this cook's entries. If that registration did not
        take (an older Houdini without pdg.PathMap.edit, say), fall back to
        rendering our own mapping. Skipped when the user has deliberately set
        Path Mapping to "None".
        """
        if self["pdg_mapmode"].evaluateInt() == 1 or not self._remote_project:
            return
        if self._remote_project in (task_env.get("PDG_PATHMAP") or ""):
            return
        task_env["PDG_PATHMAP"] = rpdeps.pathmap_env(self._pathmap)
        task_env["PDG_DELOCALIZE"] = "0"

    # -------------------------------------------------------------------------
    # Path map
    # -------------------------------------------------------------------------

    def _registerPathMap(self):
        """Put this cook's local <-> farm mappings into the global PDG path map.

        Two directions are needed, and they are separate entries:

        - LINUX zone, local -> farm: what the job on the pod applies to every
          path it is handed (pdgcmd's _buildPathMap).
        - this machine's zone, farm -> local: what localizePath applies to the
          paths work items report back, so downstream nodes and the output
          downloader see real local files.

        Entries are tagged with this scheduler's name so onStopCook can drop
        exactly ours and leave any hand-authored mappings alone.
        """
        import pdg

        try:
            with pdg.PathMap.edit() as pmap:
                pmap.clearSchedulerMappings(self.name)
                local_zone = pdg.PathMap.mappingZone()
                for local, remote in self._pathmap.items():
                    pmap.addPathMapping(pdg.PathMap.LinuxZone, local, remote, self.name)
                    if local_zone and local_zone != pdg.PathMap.LinuxZone:
                        pmap.addPathMapping(local_zone, remote, local, self.name)
        except AttributeError as e:
            # Older PDG without the edit-block API: _ensurePathMapEnv still
            # gets the job side right, only localizePath is degraded.
            self._verboseLog("path map registration unavailable: {}".format(e))

    def _clearPathMap(self):
        import pdg

        try:
            with pdg.PathMap.edit() as pmap:
                pmap.clearSchedulerMappings(self.name)
        except AttributeError:
            pass

    def _tagPathMap(self, work_item):
        """Record this cook's {local prefix: farm prefix} on a work item.

        Downstream nodes get the mapping from the item rather than from a
        handle on the scheduler, which they have no reliable way to reach. A
        failure here must never fail the item: the mapping is a convenience,
        and localizePath still works through the global path map.
        """
        if work_item is None or not self._pathmap:
            return
        try:
            work_item.setStringAttrib("rpfarm_pathmap", json.dumps(self._pathmap))
        except Exception as e:
            self._verboseLog("could not tag item {} with the path map: {}".format(
                work_item.id, e))

    def _loadPathMap(self):
        """Build {local prefix: farm prefix} for this cook.

        Always contains the job directory. runpodfarm_upload (Task 9) writes
        the external-reference entries it uploaded to
        $JOB/.rpfarm_pathmap.json; they are merged in when that file exists.
        """
        pmap = {self._job_dir: self._remote_project}
        local_root = self.workingDir(True)
        if local_root and local_root not in pmap:
            pmap[local_root] = self.workingDir(False)

        ext = os.path.join(self._job_dir, ".rpfarm_pathmap.json")
        try:
            with open(ext, "r") as f:
                extra = json.load(f)
            if isinstance(extra, dict):
                for local, remote in extra.items():
                    pmap.setdefault(str(local), str(remote))
                self._verboseLog(
                    "path map: {} extra entries from {}".format(len(extra), ext))
        except (OSError, ValueError):
            pass
        return pmap

    # -------------------------------------------------------------------------
    # Working directory management
    # -------------------------------------------------------------------------

    def _updateWorkingDir(self):
        """
        Sets the full path to the local and remote working directory.

        The remote side defaults to this cook's project directory on the shared
        volume, so PDG's temp/script/data directories land under
        /workspace/projects/<user>/<project>/pdgtemp -- the same place the path
        map sends everything else.
        """
        working_dir = self["pdg_workingdir"].evaluateString()

        if self["rpfarm_overrideremoteworkingdir"].evaluateBool():
            remote_working_dir = self["rpfarm_remoteworkingdir"].evaluateString()
        else:
            remote_working_dir = self._remote_project

        working_dir = os.path.normpath(working_dir).replace("\\", "/")
        remote_working_dir = posixpath.normpath(remote_working_dir)

        self.setWorkingDir(working_dir, remote_working_dir)

    def _initWorkingDir(self):
        """
        Sanity check the local shared root and create the working dir if needed.
        """
        self._updateWorkingDir()

        working_dir_local = self.workingDir(True)
        if working_dir_local is None:
            raise CookError("Could not resolve working directory.")

        if not os.path.exists(working_dir_local):
            try:
                os.makedirs(working_dir_local)
            except OSError:
                pass
            if not os.path.exists(working_dir_local):
                raise CookError(
                    "Could not create working directory: " + working_dir_local
                )

        if not os.path.exists(self.tempDir(True)):
            os.makedirs(self.tempDir(True))

    # -------------------------------------------------------------------------
    # v2: farm plumbing
    # -------------------------------------------------------------------------

    def _scale_up(self, count):
        """Create up to `count` GPU pods, clamped by Max Pods."""
        max_pods = self["rpfarm_maxpods"].evaluateInt()
        count = min(count, max_pods - len(self._dispatcher.pods))
        if count <= 0:
            return 0

        slots = self["rpfarm_slots"].evaluateInt()
        created = 0
        for _ in range(count):
            name = rppods.pod_name(
                self._cfg.user, self._project, self._cook_id,
                len(self._dispatcher.pods) + 1,
            )
            env = rppods.pod_env(self._cfg, "gpu", self._token, slots, self._pubkey)
            try:
                pod = self._api.create_gpu_pod(
                    name, self._templateId(), self._gpu_list, self._volumeId(),
                    env, rppods.PORTS,
                )
            except RunPodError as e:
                self._log("pod create failed ({}): {}".format(", ".join(self._gpu_list), e))
                self._last_pod_error = str(e)
                continue
            pod_id = pod["id"]
            self._dispatcher.add_pod(pod_id, 0.0, status="CREATED", created_at=time.time())
            self._clients[pod_id] = WorkerClient(pod_id, self._token)
            self._last_pod_error = None
            created += 1
            self._log("pod created {} {}".format(name, pod_id))
        if created == 0:
            # Nothing was created: back off before asking again, and leave
            # _last_pod_error where the Status tab can show it.
            self._last_scale_failure = time.time()
        return created

    def _templateId(self):
        return self["rpfarm_templateid"].evaluateString() or self._cfg.template_id

    def _volumeId(self):
        return self["rpfarm_networkvolumeid"].evaluateString() or self._cfg.volume_id

    def _poll_pods(self):
        """Track pod health: CREATED -> RUNNING on the first /health, and give
        up on a pod that never boots or that stops answering.

        The two deadlines are different and dispatch.pod_timed_out keeps them
        apart: a booting pod has not failed a heartbeat, it has simply not
        started one yet.
        """
        now = time.time()
        for pod in list(self._dispatcher.pods.values()):
            if now - self._last_health_poll.get(pod.pod_id, 0.0) < _HEALTH_POLL_INTERVAL:
                continue
            self._last_health_poll[pod.pod_id] = now

            client = self._clients.get(pod.pod_id)
            health = client.health() if client else None
            if health:
                pod.health_fail_since = None
                if pod.status != "RUNNING":
                    self._promote_pod(pod, health)
                continue

            if pod.health_fail_since is None:
                pod.health_fail_since = now

            reason = rpdispatch.pod_timed_out(pod, now)
            if reason is not None:
                self._giveUpOnPod(pod, reason)

    def _giveUpOnPod(self, pod, reason):
        """Terminate a pod and requeue whatever it was running.

        _terminate_pod first, while the pod is still in the pool: it banks the
        pod's spend into the cook total, which a bare api.terminate_pod would
        have thrown away along with the budget decision and the ledger's
        cook_summary.
        """
        if reason == "boot":
            self._log("pod {} never answered in {:.0f}s, giving up on it".format(
                pod.pod_id, rpdispatch.POD_BOOT_TIMEOUT_SECONDS))
        else:
            self._log("pod {} unreachable for {:.0f}s, requeueing {} task(s)".format(
                pod.pod_id, rpdispatch.POD_DEAD_AFTER_SECONDS, len(pod.running)))
        self._terminate_pod(pod.pod_id)
        self._dispatcher.pod_dead(pod.pod_id)
        self._reportFailures()

    def _promote_pod(self, pod, health):
        """A pod answered /health for the first time: record its price and GPU."""
        try:
            info = self._api.get_pod(pod.pod_id) or {}
        except RunPodError as e:
            self._verboseLog("get_pod {} failed: {}".format(pod.pod_id, e))
            info = {}
        pod.cost_per_hr = float(info.get("costPerHr") or 0.0)
        gpus = health.get("gpus") or []
        pod.gpu = gpus[0].get("name", "") if gpus else str(info.get("machineType") or "")
        pod.status = "RUNNING"
        pod.idle_since = time.time()
        boot = time.time() - (pod.created_at or time.time())
        self._log("pod {} RUNNING after {:.0f}s, ${:.3f}/h, gpu={}".format(
            pod.pod_id, boot, pod.cost_per_hr, pod.gpu or "?"))

    def _dispatch_pending(self):
        """Submit queued tasks to pods with free slots."""
        while self._dispatcher.pending:
            pod = self._dispatcher.pick_pod()
            if not pod:
                return
            task = self._dispatcher.pending[0]
            client = self._clients.get(pod.pod_id)
            if client is None:
                self._dispatcher.mark_full(pod.pod_id)
                continue
            try:
                result = client.submit(
                    task.task_id, task.command, task.env, log_path=task.log_path)
            except WorkerError as e:
                # A transport hiccup or an unexpected status: skip the pod for
                # this tick. _poll_pods decides whether it is actually dead.
                self._verboseLog("submit to {} failed: {}".format(pod.pod_id, e))
                self._dispatcher.mark_full(pod.pod_id)
                continue

            if result == "accepted":
                self._dispatcher.assign(task.task_id, pod.pod_id)
                task.started = time.time()
                # PDG times an item from this call to workItemSucceeded; without
                # it the UI shows every item as 0.0s and never as "cooking".
                if task.work_item_id >= 0:
                    self.workItemStartCook(task.work_item_id, -1)
                self._verboseLog("task {} -> pod {} (item {})".format(
                    task.task_id, pod.pod_id, task.work_item_id))
            elif result == "busy":
                # The pod's own slot count disagrees with ours; believe the pod.
                self._dispatcher.mark_full(pod.pod_id)
            else:  # "duplicate" -- the id was used before; mint a fresh one once
                if task.task_id.endswith("-r"):
                    self._log("task {} rejected as duplicate twice, failing item {}".format(
                        task.task_id, task.work_item_id))
                    # onto dispatcher.failed, so _reportFailures tells PDG on
                    # the next tick -- the same single path every other failure
                    # takes, instead of reporting the item from here.
                    self._dispatcher.fail_pending(task.task_id)
                else:
                    self._dispatcher.retask(task.task_id, uuid.uuid4().hex + "-r")

    def _poll_tasks(self):
        """Ask each pod about the tasks it is running and retire the finished."""
        now = time.time()
        for task in self._dispatcher.running_tasks():
            if now - self._last_task_poll.get(task.task_id, 0.0) < _TASK_POLL_INTERVAL:
                continue
            self._last_task_poll[task.task_id] = now

            client = self._clients.get(task.pod_id)
            status = client.status(task.task_id) if client else None
            if not status or status.get("state") == "running":
                continue
            self._last_task_poll.pop(task.task_id, None)

            ok = status.get("state") == "succeeded"
            # Keep the fraction: the ledger is a cost record, and int() made
            # every sub-second task cost exactly nothing.
            duration = round(float(status.get("duration_s") or 0.0), 3)
            pod = self._dispatcher.pods.get(task.pod_id)
            self._dispatcher.complete(task.task_id, ok)

            _ledger_append(
                self._ledger_path,
                cook_id=self._cook_id,
                user=self._cfg.user,
                project=self._project,
                work_item=task.work_item_id,
                work_item_name=self._itemName(task.work_item_id),
                pod=task.pod_id,
                gpu=pod.gpu if pod else "",
                started=task.started,
                ended=time.time(),
                duration_s=duration,
                exit_code=status.get("exit_code"),
                cost_est=(pod.cost_per_hr if pod else 0.0) * duration / 3600.0,
            )

            work_item = self._work_items.pop(task.work_item_id, None)
            if ok:
                self.workItemSucceeded(task.work_item_id, -1, duration)
                self._render_times = (
                    self._render_times + [duration])[-_AUTOSCALE_HISTORY_SIZE:]
                if work_item is not None:
                    self._download_outputs(work_item)
            else:
                # complete(ok=False) has already put the task on
                # dispatcher.failed; _reportFailures is the single place that
                # tells PDG. Reporting it here as well made every pod-side
                # failure arrive at workItemFailed twice.
                self._logTaskFailure(task, status)

    def _itemName(self, work_item_id):
        item = self._work_items.get(work_item_id)
        return item.name if item is not None else str(work_item_id)

    def _logTaskFailure(self, task, status):
        """Put the tail of a failed task's log where the artist will see it."""
        tail = status.get("tail") or []
        self._log("item {} failed on pod {} (exit {}), log {}".format(
            task.work_item_id, task.pod_id, status.get("exit_code"), task.log_path))
        for line in tail[-20:]:
            self._log("  | {}".format(line))

    def _reportFailures(self):
        """Tell PDG about tasks the dispatcher has given up retrying."""
        for task in self._dispatcher.failed_since_last_call():
            self._log("item {} failed after {} attempt(s)".format(
                task.work_item_id, task.attempts))
            self._work_items.pop(task.work_item_id, None)
            self.workItemFailed(task.work_item_id, -1)

    # -------------------------------------------------------------------------
    # Output download
    # -------------------------------------------------------------------------

    def _download_outputs(self, work_item):
        """Queue this work item's outputs for download, right away.

        The item reports its outputs over MQ while it runs, so by the time we
        see it succeed they are in work_item.resultData as farm paths.
        localizePath turns each one into the local path the ROP was aimed at.

        Grouping (local dir, farm dir) -- rclone's --files-from lines have to
        be relative to both roots at once (ruling R8) -- is
        rpfarm.packages.group_download_pairs, shared with the
        runpodfarm_download node (Task 10) so the two download paths can't
        drift apart.
        """
        if not self["rpfarm_downloadoutputs"].evaluateInt():
            return
        pairs = []
        for rd in work_item.resultData:
            remote = rd[0] if isinstance(rd, (tuple, list)) else str(rd)
            local = self.localizePath(remote)
            if not local or local == remote:
                # Not under any mapping we know: nothing to pull it to.
                continue
            pairs.append((remote, local))
        groups = rppkg.group_download_pairs(pairs)
        for local_root, remote_root, entries in groups:
            self._sync_queue.append((local_root, remote_root, entries))
        if groups:
            self._verboseLog("queued {} output(s) of item {} for download".format(
                sum(len(entries) for _, _, entries in groups), work_item.id))

    def _drain_sync_queue(self, block=False, deadline=None):
        """Run queued downloads. Failures go back on the queue and are retried
        on a later tick; when blocking, until the deadline passes.

        Non-blocking, this moves **one** package per call: rclone runs
        synchronously with no timeout, so draining the whole queue inside a
        tick lets one heavy sequence stall pod polling and dispatch behind it.
        onStopCook passes block=True and drains the lot under its deadline.
        """
        while self._sync_queue:
            local_root, remote_root, entries = self._sync_queue.pop(0)
            try:
                os.makedirs(local_root, exist_ok=True)
                rpsync.rclone_copy(
                    entries, self._sftp, "down", self._cfg.rclone_path,
                    local_root=local_root, remote_root=remote_root,
                )
                self._verboseLog("downloaded {} file(s) to {}".format(
                    len(entries), local_root))
                if not block:
                    return
            except (rpsync.SyncError, OSError) as e:
                self._verboseLog("download failed ({}), will retry: {}".format(
                    remote_root, e))
                self._sync_queue.append((local_root, remote_root, entries))
                if not block:
                    return
                if deadline is not None and time.time() > deadline:
                    self._log("giving up on {} queued download(s)".format(
                        len(self._sync_queue)))
                    return
                time.sleep(2)

    # -------------------------------------------------------------------------
    # Cost
    # -------------------------------------------------------------------------

    def _update_cost_tracking(self):
        """Accumulate this cook's GPU spend and act on the budget."""
        if not self._cost_tracker:
            return "ok"
        now = time.time()
        total = 0.0
        for pod in self._dispatcher.pods.values():
            started = pod.created_at or self._cost_tracker["start_time"]
            total += pod.cost_per_hr * (now - started) / 3600.0
        total += self._cost_tracker.get("retired_cost", 0.0)
        self._cost_tracker["total_cost"] = total

        state = rpdispatch.budget_state(total, self._cost_tracker["max_cost"])
        self._cost_tracker["over_budget"] = state in ("stop", "kill")
        if state != self._cost_tracker.get("state"):
            self._cost_tracker["state"] = state
            if state != "ok":
                self._log("budget {}: ${:.2f} of ${:.2f}".format(
                    state, total, self._cost_tracker["max_cost"]))
        return state

    def _retire_pod_cost(self, pod):
        """Bank a terminated pod's spend so it stays in the cook total."""
        started = pod.created_at or self._cost_tracker.get("start_time", time.time())
        self._cost_tracker["retired_cost"] = self._cost_tracker.get(
            "retired_cost", 0.0) + pod.cost_per_hr * (time.time() - started) / 3600.0

    def _terminate_pod(self, pod_id):
        pod = self._dispatcher.pods.get(pod_id)
        if pod is not None:
            self._retire_pod_cost(pod)
        self._clients.pop(pod_id, None)
        self._last_health_poll.pop(pod_id, None)
        try:
            self._api.terminate_pod(pod_id)
        except RunPodError as e:
            # Always visible: a pod that would not terminate is still being
            # billed, and the artist has to know to go and kill it.
            self._log("TERMINATE FAILED for pod {}: {} -- it may still be "
                      "running and billing. Use Kill All Pods.".format(pod_id, e))

    # -------------------------------------------------------------------------
    # Status tab
    # -------------------------------------------------------------------------

    def _update_status_text(self, force=False):
        if not self._cook_id:
            # No cook running. onStopCook resets the state and PDG can still
            # fire one more onTick afterwards; writing then would wipe the
            # finished cook's summary off the tab just as it is wanted.
            return
        now = time.time()
        if not force and now - self._last_status_update < _STATUS_REFRESH_SECONDS:
            return
        self._last_status_update = now

        lines = ["cook {}  project {}".format(self._cook_id, self._project)]
        if self._sync_pod:
            lines.append("sync pod {}".format(self._sync_pod["id"]))
        for pod in sorted(self._dispatcher.pods.values(), key=lambda p: p.pod_id):
            # No "$" anywhere in this text: Houdini expands variables when it
            # evaluates a string parm, so "$0.740/h" reaches the artist as
            # ".740/h" ($0 being an empty variable). Verified on 22.0.368.
            lines.append("  {} {:<8} {:<28} {}/{} busy  {:.3f} USD/h".format(
                pod.pod_id, pod.status, pod.gpu or "-",
                len(pod.running), pod.slots, pod.cost_per_hr))
        if not self._dispatcher.pods:
            lines.append("  (no GPU pods)")
        lines.append("tasks: {} pending, {} running, {} failed".format(
            len(self._dispatcher.pending), len(self._dispatcher.running_tasks()),
            len(self._dispatcher.failed)))
        if self._sync_queue:
            lines.append("downloads queued: {}".format(len(self._sync_queue)))
        if self._last_pod_error:
            lines.append("last pod create error: {}".format(self._last_pod_error))
        max_cost = self._cost_tracker.get("max_cost", 0.0)
        lines.append("cost: {:.3f} USD{}".format(
            self._cost_tracker.get("total_cost", 0.0),
            "" if max_cost in (0.0, float("inf")) else " of {:.2f} USD".format(max_cost)))
        if self._ledger_mirror_note:
            lines.append("ledger: {}".format(self._ledger_mirror_note))
        self._setStatusText("\n".join(lines))

    def _setStatusText(self, text):
        """Write the Status tab's text field.

        PyScheduler.setParameter goes through PDG's own parameter store and
        does not reach the HDA's parm -- it reports no error and the field
        stays empty (that is what the first live cook showed). The TOP node
        itself has to be written, and the scheduler only knows it by session
        id. Cosmetic either way: a cook must never die over a text field.
        """
        node = self._houNode()
        if node is None:
            return
        try:
            node.parm("rpfarm_status_text").set(text)
        except Exception as e:
            self._verboseLog("status text update failed: {}".format(e))

    def _houNode(self):
        """The hou node this scheduler runs on, or None."""
        try:
            import hou

            node_id = self.topNodeId
            if node_id is None or node_id < 0:
                self._verboseLog("no TOP node id for the status text")
                return None
            return hou.nodeBySessionId(node_id)
        except Exception as e:
            self._verboseLog("cannot reach the TOP node: {}".format(e))
            return None

    # -------------------------------------------------------------------------
    # Scheduler callbacks
    # -------------------------------------------------------------------------

    def onStart(self):
        """[virtual] Scheduler start callback."""
        return True

    def onStop(self):
        """[virtual] Called before the underlying scheduler PDG node is destroyed."""
        return True

    def onStartCook(self, static, cook_set):
        """[virtual] Cook start callback.

        Loads ~/.rpfarm/config.toml, builds the RunPod client, names the cook,
        registers the path map and checks for money and orphan pods. No pod is
        created here -- that is onSetupCook's job.
        """
        import hou

        self._reset_cook_state()

        self._verbose = max(
            self["rpfarm_verbose"].evaluateInt(),
            int(os.environ.get("PDG_VERBOSE", "0")),
        )

        try:
            self._cfg = rpcfg.load()
        except rpcfg.ConfigError as e:
            raise CookError(
                "{}\nRunPodFarm reads its settings from {}.".format(
                    e, rpcfg.home() / rpcfg.CONFIG_FILENAME)) from e

        api_key = self["rpfarm_apikey"].evaluateString() or self._cfg.api_key
        if not api_key:
            raise CookError(
                "No RunPod API key. Set the API Key parameter, or run `rpfarm setup`.")
        self._api = RunPodAPI(api_key)

        if not self._templateId():
            raise CookError(
                "No RunPod template id. Set the Template ID parameter, or run "
                "`rpfarm setup`.")

        self._token = rpcfg.session_token()
        self._pubkey = _read_pubkey(self._cfg)

        job_dir = hou.getenv("JOB") or hou.getenv("HIP") or os.getcwd()
        self._job_dir = os.path.normpath(job_dir).replace("\\", "/")
        self._project = (
            self["rpfarm_project"].evaluateString()
            or os.path.basename(self._job_dir)
            or "default"
        )
        self._cook_id = uuid.uuid4().hex[:8]
        self._remote_project = "/workspace/projects/{}/{}".format(
            self._cfg.user, self._project)

        gpus = self["rpfarm_gpulist"].evaluateString()
        self._gpu_list = [g.strip() for g in gpus.split(",") if g.strip()]
        if not self._gpu_list:
            self._gpu_list = list(self._cfg.gpu_priority)
        if not self._gpu_list:
            raise CookError(
                "No GPU types listed. Fill in GPU Priority on the Farm tab, or "
                "set gpu_priority in ~/.rpfarm/config.toml.")

        self._dispatcher = rpdispatch.Dispatcher(
            self["rpfarm_slots"].evaluateInt(), max_attempts=3)
        self._ledger_path = str(
            rpcfg.home() / "ledger" / "{}.jsonl".format(self._cook_id))
        self._last_pod_error = None

        max_cost = self["rpfarm_maxcost"].evaluateFloat()
        self._cost_tracker = {
            "start_time": time.time(),
            "total_cost": 0.0,
            "retired_cost": 0.0,
            "max_cost": max_cost if max_cost > 0.0 else float("inf"),
            "state": "ok",
            "over_budget": False,
        }

        # The working dir has to be set before the path map, which uses it.
        self._initWorkingDir()
        self._pathmap = self._loadPathMap()
        self._registerPathMap()

        self._checkBalance()
        self._retireStaleSyncPod()
        self._warnAboutOrphans()

        self._log("cook {} project '{}' -> {} (gpus: {})".format(
            self._cook_id, self._project, self._remote_project,
            ", ".join(self._gpu_list)))
        return True

    def _checkBalance(self):
        """Warn, but do not block, when the RunPod balance is low."""
        threshold = self["rpfarm_minbalance"].evaluateFloat()
        if threshold <= 0:
            return
        try:
            balance = self._api.balance()
        except (RunPodError, OSError, KeyError, ValueError, TypeError) as e:
            # A warning must never be the thing that fails a cook: OSError
            # covers the transport (DNS, TLS, timeouts), the rest cover a
            # GraphQL reply that is not shaped the way we expect.
            self._log("balance check failed, continuing: {}".format(e))
            return
        if balance >= threshold:
            self._verboseLog("RunPod balance ${:.2f}".format(balance))
            return
        message = "RunPod balance is ${:.2f}, below the ${:.2f} warning threshold.".format(
            balance, threshold)
        self._log(message)
        import hou

        if hou.isUIAvailable():
            hou.ui.displayMessage(message, severity=hou.severityType.Warning)

    def _retireStaleSyncPod(self):
        """Terminate the sync pod when it has been unused past Sync Pod Idle.

        The pod cannot do this itself without holding a RunPod API key, so the
        next cook to start does it instead, reading the timestamp the previous
        cook left on the volume.
        """
        idle_min = self["rpfarm_syncidle"].evaluateInt()
        if idle_min <= 0:
            return
        name = rppods.sync_pod_name(self._cfg.user)
        try:
            existing = [p for p in self._api.list_pods(name) if p.get("name") == name]
        except RunPodError as e:
            self._verboseLog("sync pod lookup failed: {}".format(e))
            return
        for pod in existing:
            if pod.get("desiredStatus") != "RUNNING":
                continue
            stamp = WorkerClient(pod["id"], self._token).read_file(_SYNC_LAST_USED)
            try:
                last_used = float((stamp or "").strip())
            except ValueError:
                continue
            idle_for = time.time() - last_used
            if idle_for > idle_min * 60:
                self._log("sync pod {} idle for {:.0f} min, terminating".format(
                    pod["id"], idle_for / 60.0))
                try:
                    self._api.terminate_pod(pod["id"])
                except RunPodError as e:
                    self._verboseLog("terminate sync pod failed: {}".format(e))

    def _warnAboutOrphans(self):
        """Offer to kill this user's leftover GPU pods from an earlier cook."""
        try:
            orphans = rppods.find_orphans(self._api, self._cfg.user)
        except RunPodError as e:
            self._verboseLog("orphan check failed: {}".format(e))
            return
        if not orphans:
            return
        names = ", ".join(p.get("name", p["id"]) for p in orphans)
        self._log("{} orphan GPU pod(s) still running: {}".format(len(orphans), names))
        import hou

        if not hou.isUIAvailable():
            # Never kill someone else's cook without being asked.
            self._log("  (headless: leaving them alone -- use Kill All Pods or "
                      "`rpfarm farm kill`)")
            return
        if hou.ui.displayMessage(
            "{} RunPod GPU pod(s) from an earlier cook are still running:\n\n{}\n\n"
            "They keep costing money until they are terminated.".format(
                len(orphans), names),
            buttons=("Kill them", "Keep them"),
            default_choice=0,
            close_choice=1,
            severity=hou.severityType.Warning,
        ) == 0:
            rppods.terminate_all(self._api, [p["id"] for p in orphans])
            self._log("terminated {} orphan pod(s)".format(len(orphans)))

    def onSetupCook(self):
        """[virtual] Called after onStartCook.

        Brings up the sync pod, ships PDG's job scripts to the farm, starts the
        MQ there and creates the initial GPU pods.
        """
        self._initWorkingDir()
        self._copyJobSupportFiles()

        self._log("waiting for sync pod {}...".format(
            rppods.sync_pod_name(self._cfg.user)))
        self._sync_pod = rppods.ensure_sync_pod(
            self._api, self._cfg, self._token, self._pubkey,
            log=self._log, cancel=lambda: self.context.canceling,
        )
        self._sync_client = WorkerClient(self._sync_pod["id"], self._token)
        ip, port = pod_public_endpoint(self._sync_pod, 22)
        self._sftp = rpsync.SftpTarget(
            host=ip, port=port, key_path=self._cfg.ssh_key_path)
        self._log("sync pod {} ready ({}:{})".format(self._sync_pod["id"], ip, port))
        self._touchSyncPod()
        self._touchProjectIndex("cook")
        self._warmSizeCache()

        # PDG's own job scripts and any serialized work item data.
        self._uploadPdgTemp()

        # startPollingClient() calls _startFarmMQ() below, which runs mqserver
        # on the sync pod and points the relay at its public ports.
        self.startPollingClient()

        wanted = max(1, self["rpfarm_minpods"].evaluateInt())
        if not self._scale_up(wanted):
            # Nothing to run on and no reason to think the next tick will do
            # better: fail the cook here with RunPod's own words rather than
            # leave the artist watching an empty farm.
            raise CookError(
                "Could not create any GPU pod for this cook (asked for {}, "
                "GPU priority: {}).\n{}".format(
                    wanted, ", ".join(self._gpu_list),
                    self._last_pod_error or "RunPod returned no pod and no error."))
        self._update_status_text(force=True)

    def _uploadPdgTemp(self):
        """Ship the local pdgtemp tree (scripts, serialized items) to the farm."""
        local = self.tempDir(True)
        remote = self.tempDir(False)
        try:
            stats = rpsync.rclone_copy_dir(
                local, self._sftp, "up", self._cfg.rclone_path, remote_root=remote)
        except (rpsync.SyncError, OSError) as e:
            raise CookError(
                "Could not upload PDG job scripts to {}: {}".format(remote, e)) from e
        self._log("pdgtemp -> {}: {} file(s), {} bytes, {:.1f}s".format(
            remote, stats.files, stats.bytes, stats.seconds))

    def _touchSyncPod(self):
        """Record 'in use now' on the sync pod so it survives the idle check."""
        if self._sync_client is None:
            return
        self._sync_client.exec(
            "mkdir -p {} && echo {} > {}".format(
                posixpath.dirname(_SYNC_LAST_USED), int(time.time()), _SYNC_LAST_USED),
            timeout_s=30,
        )

    def _touchProjectIndex(self, event):
        """Stamp this project's entry in housekeeping's /workspace/.rpfarm/index.json.

        Best-effort like ``_touchSyncPod`` beside it: an index update is
        bookkeeping for the Volume tab and ``prune``, never something that
        should fail a cook. Called once per cook (event "cook") right
        after the sync pod connection is established -- ``onStartCook``
        runs before any pod exists, so this can't happen there without
        forcing an early, otherwise-unneeded sync pod creation.
        """
        if self._sync_client is None or not self._cfg or not self._project:
            return
        key = "{}/{}".format(self._cfg.user, self._project)
        self._sync_client.exec(
            "{} touch {} --event {}".format(_HOUSEKEEPING, _shquote(key), event), timeout_s=30)

    def _warmSizeCache(self):
        """Refresh housekeeping's per-zone size cache once per cook.

        Fix round 2, "A": every upload item's auto-grow check calls
        `disk-usage`, which can end up walking the (potentially huge,
        ~30s+ cold on the real farm's legacy install) `houdini` zone if
        its cached size has gone stale -- this keeps that rare by
        refreshing once per cook, off the per-item hot path.

        Fix round 3, "1": deliberately does NOT pass `--refresh` --
        `_SizeCache.get()`'s early return is `if not refresh and not
        stale`, so `--refresh` ignores freshness and re-measures every
        zone unconditionally (confirmed live: 30.89s even with the
        `houdini` entry already warm). Plain staleness-based caching
        (the same the per-item hot path itself uses) gets both
        properties for free: near-zero cost when nothing has actually
        gone stale (e.g. two cooks close together), and a bounded
        remeasure -- not a silent skip -- when something has. Generously
        timed out (a cold walk can take a while) and never fatal to the
        cook if it fails or times out.
        """
        if self._sync_client is None:
            return
        try:
            self._sync_client.exec(
                "{} disk-usage --budget-s 90".format(_HOUSEKEEPING), timeout_s=110)
        except Exception as e:  # noqa: BLE001 - a cache warm-up must never fail a cook
            self._verboseLog("size cache warm-up failed (continuing): {}".format(e))

    def _mirror_ledger_to_volume(self):
        """Push this cook's local ledger .jsonl up to the volume (Ruling
        R25), reusing the sync pod connection onSetupCook already
        established for this cook -- never creates a pod just for this.

        Before this ruling, nothing ever wrote the volume's ledger tree, so
        rpfarm.ledger.sync_from_volume (Refresh, on runpodfarm_stats) had
        structurally nothing to pull and cross-user cost accounting never
        actually worked. This closes that gap.

        Never fails the cook: caught exceptions (and the "no sync pod"
        case, e.g. a cook cancelled before onSetupCook finished) are logged
        and recorded in self._ledger_mirror_note, which
        _update_status_text surfaces to the artist as "ledger stayed
        local-only" -- the journal itself is never lost, only not yet
        shared.
        """
        if rpledger is None or not hasattr(rpledger, "mirror_to_volume"):
            return  # dispatch.append_record stand-in has no mirror; nothing to push with
        if self._sftp is None or self._cfg is None:
            self._log("ledger mirror skipped: no sync pod this cook (ledger stayed local-only)")
            self._ledger_mirror_note = "local-only (no sync pod this cook)"
            return
        try:
            stats = rpledger.mirror_to_volume(
                self._ledger_path, self._cfg.user, self._sftp, self._cfg.rclone_path)
            self._log("ledger mirrored -> /workspace/ledger/{}/: {} file(s), {:.1f}s".format(
                self._cfg.user, stats.files, stats.seconds))
            self._ledger_mirror_note = None
        except (rpsync.SyncError, OSError) as e:
            self._log("ledger mirror failed (ledger stayed local-only): {}".format(e))
            self._ledger_mirror_note = "local-only (volume mirror failed, see log)"

    # -- MQ (SimpleMQSchedulerMixin interface) --------------------------------

    def _startFarmMQ(self):
        """Start PDG's mqserver on the sync pod and connect the relay to it.

        Called by SimpleMQSchedulerMixin._getOrStartMQ when Message Queue is set
        to Farm. rppods.start_mq starts the server, waits for its connection
        file on the volume and rewrites the address in it to the pod's public IP
        and mapped ports, which is what the relay (here) and the render pods
        (via PDG_RESULT_SERVER) both have to dial.
        """
        if self._sync_client is None or self._sync_pod is None:
            raise CookError("MQ requested before the sync pod was ready.")
        try:
            conn_line = rppods.start_mq(self._sync_client, self._sync_pod, self._cook_id)
        except (TimeoutError, RunPodError, ValueError) as e:
            raise CookError(
                "mqserver did not start on sync pod {}: {}\nIts log is at "
                "/workspace/ledger/logs/mq_{}.log on the volume.".format(
                    self._sync_pod["id"], e, self._cook_id)) from e
        if not self._setMQAddressFromString(conn_line):
            raise CookError("Could not parse the MQ address: {!r}".format(conn_line))

    def _killFarmMQ(self):
        if self._sync_client is not None:
            try:
                rppods.stop_mq(self._sync_client)
            except Exception as e:  # never let cleanup break a cook's teardown
                self._verboseLog("stop_mq failed: {}".format(e))

    # -- scheduling -----------------------------------------------------------

    def onSchedule(self, work_item):
        """[virtual] Queue a work item and try to place it on a pod."""
        # Backpressure first, before any work and before the enqueue below.
        # scheduleResult.Deferred puts the item back on PDG's own queue and it
        # is offered again later (pdg/staticcook.py:136), so enqueueing and
        # *then* declining would queue -- and run -- the same item twice.
        # (There is also FullDeferred, which additionally stops PDG offering
        # any further item this pass; Deferred is the conservative choice.)
        if rpdispatch.should_defer(
                len(self._dispatcher.pending), len(self._dispatcher.pods)):
            self._verboseLog("deferring item {}: {} queued for {} pod(s)".format(
                work_item.id, len(self._dispatcher.pending),
                len(self._dispatcher.pods)))
            return scheduleResult.Deferred

        # 0. Stamp this cook's local <-> farm mapping onto the item, before it
        #    is serialized. runpodfarm_download (Task 10) reads it off its
        #    upstream items to turn the farm paths in resultData back into
        #    local ones without needing a handle on this scheduler.
        self._tagPathMap(work_item)

        # 1. Ensure directories exist and serialize the work item
        self.createJobDirsAndSerializeWorkItems(work_item)

        # 2. Expand the special __PDG__* tokens in the work item command and
        #    pre/post task commands
        pre_task_command = self.expandCommandTokens(
            self.evaluateStringOverride(
                work_item.node, self.parmprefix, "pretaskcmd", work_item, ""
            ),
            work_item,
        )
        post_task_command = self.expandCommandTokens(
            self.evaluateStringOverride(
                work_item.node, self.parmprefix, "posttaskcmd", work_item, ""
            ),
            work_item,
        )
        item_command = self.expandCommandTokens(work_item.command, work_item)

        # 3. Build full command with pre/post task commands
        full_command = item_command
        if pre_task_command:
            full_command = "{} && {}".format(pre_task_command, full_command)
        if post_task_command:
            full_command = "{} && {}".format(full_command, post_task_command)

        # 4. Prepare task env
        task_env = self._prepareTaskEnv(work_item.node, work_item)

        # 5. Serialized item data only exists as a file when the data source is
        #    JSON File; the pod needs it before the task runs. The default
        #    (RPC Message) fetches it over MQ instead and skips this entirely.
        if int(self.workItemDataSource) == 0:
            self._uploadItemData()

        # 6. Queue and place
        task = rpdispatch.TaskState(
            task_id=uuid.uuid4().hex,
            work_item_id=work_item.id,
            command=full_command,
            env=task_env,
            pod_id=None,
            attempts=0,
            started=None,
            log_path="/workspace/ledger/logs/{}/{}.log".format(
                self._cook_id, work_item.name),
        )
        self._work_items[work_item.id] = work_item
        self._dispatcher.enqueue(task)
        self._dispatch_pending()
        return scheduleResult.Succeeded

    def _uploadItemData(self):
        """Push the serialized work item JSON to the farm (JSON File mode)."""
        try:
            rpsync.rclone_copy_dir(
                self.dataDir(True), self._sftp, "up", self._cfg.rclone_path,
                remote_root=self.dataDir(False),
            )
        except (rpsync.SyncError, OSError) as e:
            self._verboseLog("work item data upload failed: {}".format(e))

    def onTick(self):
        """[virtual] Called during a cook: poll pods and tasks, scale, spend."""
        if not self.checkPollingClient():
            return tickResult.SchedulerCancelCook

        self._dispatcher.release_full()
        self._poll_pods()
        self._dispatch_pending()
        self._poll_tasks()
        self._reportFailures()
        self._drain_sync_queue()

        budget = self._update_cost_tracking()
        if budget == "kill" and not self._killed_over_budget:
            self._killed_over_budget = True
            self._log("budget exceeded by 20%: terminating every pod in this cook")
            for pod_id in list(self._dispatcher.pods):
                self._terminate_pod(pod_id)
                self._dispatcher.remove_pod(pod_id)
            self.cookError(
                "RunPodFarm budget exceeded: ${:.2f} spent against a ${:.2f} limit. "
                "All pods for this cook were terminated.".format(
                    self._cost_tracker["total_cost"], self._cost_tracker["max_cost"]))
            return tickResult.SchedulerCancelCook

        self._autoscale()
        self._retireIdlePods()
        self._update_status_text()

        time.sleep(1)
        return tickResult.SchedulerReady

    def _autoscale(self):
        if time.time() - self._last_scale_failure < _SCALE_RETRY_BACKOFF:
            # RunPod just refused; out-of-stock GPUs do not come back within a
            # tick, and retrying every second only burns API calls.
            return
        pending = len(self._dispatcher.pending)
        count = rpdispatch.autoscale_decision(
            pending=pending,
            active_pods=self._dispatcher.active_pods(),
            max_pods=self["rpfarm_maxpods"].evaluateInt(),
            render_times=self._render_times,
            over_budget=self._cost_tracker.get("over_budget", False),
        )
        # A pod that exists but has not booted yet already covers pending work.
        count -= sum(1 for p in self._dispatcher.pods.values() if p.status == "CREATED")
        if count > 0:
            self._log("autoscale: {} pending, adding {} pod(s)".format(pending, count))
            self._scale_up(count)

    def _retireIdlePods(self):
        """Terminate pods that have had nothing to do for Idle Timeout seconds.

        Min Pods is honoured only while there is still work queued: once the
        cook has nothing pending, an idle pod is pure cost.
        """
        now = time.time()
        self._dispatcher.touch_idle(now)
        timeout = self["rpfarm_idletimeout"].evaluateInt()
        if timeout <= 0:
            return
        floor = self["rpfarm_minpods"].evaluateInt() if self._dispatcher.pending else 0
        for pod in self._dispatcher.idle_pods(now, timeout):
            if len(self._dispatcher.pods) <= floor:
                break
            self._log("pod {} idle for {}s, terminating".format(pod.pod_id, timeout))
            self._terminate_pod(pod.pod_id)
            self._dispatcher.remove_pod(pod.pod_id)

    def onStopCook(self, cancel):
        """[virtual] Called when the cook ends. May be called more than once."""
        if self._api is None:
            return True

        self._log("cook {} stopping (cancel={}), {} pod(s), {} task(s) in flight".format(
            self._cook_id, cancel, len(self._dispatcher.pods),
            len(self._dispatcher.running_tasks())))

        if cancel:
            for task in self._dispatcher.running_tasks():
                client = self._clients.get(task.pod_id)
                if client is not None:
                    client.kill(task.task_id)

        for pod_id in list(self._dispatcher.pods):
            self._terminate_pod(pod_id)
            self._dispatcher.remove_pod(pod_id)

        if not cancel and self._sync_queue:
            self._log("finishing {} queued download(s)...".format(len(self._sync_queue)))
            self._drain_sync_queue(
                block=True, deadline=time.time() + _STOP_DRAIN_MAX_SECONDS)

        # The sync pod stays up for the next cook; stamp it so a later cook can
        # retire it once it has been idle long enough.
        self._touchSyncPod()

        _ledger_append(
            self._ledger_path,
            record="cook_summary",
            cook_id=self._cook_id,
            user=self._cfg.user if self._cfg else "",
            project=self._project,
            started=self._cost_tracker.get("start_time"),
            ended=time.time(),
            canceled=bool(cancel),
            items_failed=len(self._dispatcher.failed),
            cost_est=self._cost_tracker.get("total_cost", 0.0),
        )
        self._log("cook {} done, ~${:.3f}, ledger {}".format(
            self._cook_id, self._cost_tracker.get("total_cost", 0.0),
            self._ledger_path))

        # Ruling R25: mirror this cook's local ledger up to the volume so
        # several people on one account end up with one shared record --
        # before stopPollingClient/_reset_cook_state, while self._sftp
        # (the sync pod connection this cook already holds) is still valid.
        self._mirror_ledger_to_volume()

        # Stops the relay and the mqserver on the sync pod (via _killFarmMQ).
        self.stopPollingClient()
        self._clearPathMap()
        self._update_status_text(force=True)
        self._reset_cook_state()
        return True

    # -------------------------------------------------------------------------
    # Submit as Job
    # -------------------------------------------------------------------------

    def submitAsJob(self, graph_file, node_name):
        """Cook the whole TOP graph in one hython task on a farm pod."""
        self.onStartCook(False, None)
        self.onSetupCook()

        self.transferFile(os.path.expandvars("$HHP/pdgjob/topcook.py"))
        hip_local = os.path.expandvars("$HIPFILE")
        hip_remote = "__PDG_DIR__/" + os.path.basename(hip_local)
        self.transferFile(hip_local)
        self._copyJobSupportFiles()
        self._uploadPdgTemp()

        cmd = (
            '"__PDG_HYTHON__" --pdg "__PDG_SCRIPTDIR__/topcook.py" '
            '--report none --hip "{}" --verbosity 2 '
            "--toppath {} ".format(hip_remote, node_name)
        )
        cmd = self.expandCommandTokens(cmd)
        if self["submitjobfile"].evaluateBool():
            cmd += '--taskgraphout "__PDG_DIR__/{}.post.py"'.format(graph_file)

        task_env = self._prepareTaskEnv(None, None)
        task_env["PDG_SUBMIT_AS_JOB"] = "True"

        task = rpdispatch.TaskState(
            task_id=uuid.uuid4().hex,
            work_item_id=-1,
            command=cmd,
            env=task_env,
            log_path="/workspace/ledger/logs/{}/submitasjob.log".format(self._cook_id),
        )
        self._dispatcher.enqueue(task)
        self._dispatch_pending()
        pod_id = task.pod_id or next(iter(self._dispatcher.pods), None)
        return pod_id, None

    def getLogURI(self, work_item):
        """[virtual] Log URL for the task corresponding to the given work item."""
        task = self._dispatcher.task_for_work_item(work_item.id)
        if task is None or not task.pod_id:
            return ""
        return "https://{}-8000.proxy.runpod.net/tasks/{}/log".format(
            task.pod_id, task.task_id)

    def getStatusURI(self, work_item):
        """[virtual] Status URL for the task corresponding to the given work item."""
        task = self._dispatcher.task_for_work_item(work_item.id)
        if task is None or not task.pod_id:
            return ""
        return "https://www.runpod.io/console/pods/{}".format(task.pod_id)


def submitGraphAsJob(kwargs, node):
    from pdg.scheduler import submitGraphAsJob
    submitGraphAsJob(kwargs, node, 'RunPod Farm')
