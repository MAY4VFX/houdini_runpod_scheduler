# Rolling window of work-item durations that feeds the autoscaler.
_AUTOSCALE_HISTORY_SIZE = rpdispatch.AUTOSCALE_HISTORY_SIZE

# Minimum gap between /health polls of the same pod. The pod proxy sits behind
# Cloudflare and onTick fires roughly once a second; there is nothing to gain
# from polling a pod faster than this.
_HEALTH_POLL_INTERVAL = 5.0

# Same idea for GET /tasks/<id>. Without it every running task is polled on
# every tick: four pods of four slots is ~16 requests a second through
# Cloudflare, and because a failed poll is swallowed as None, a network
# partition turns each one into a 30s timeout and the tick stops doing
# anything else for minutes.
_TASK_POLL_INTERVAL = 2.0

# After a failed pod create, wait this long before asking RunPod again --
# out-of-stock GPUs stay out of stock for more than a tick.
_SCALE_RETRY_BACKOFF = 15.0

# How often the Status tab's text is rebuilt.
_STATUS_REFRESH_SECONDS = 5.0

# Cap on how long onStopCook will keep draining queued output downloads.
_STOP_DRAIN_MAX_SECONDS = 600

# How long a finished work item is held back from workItemSucceeded while its
# output files catch up. A task's completion arrives out of band, over HTTP
# from the pod's worker, while the files it produced arrive over PDG's MQ --
# so completion can, and does, overtake the result data. When it does, every
# consumer of work_item.resultData sees an empty list: the scheduler's own
# output downloader queues nothing, and any downstream node generating on
# "All Upstream Items Cooked" (runpodfarm_download in Upstream Outputs mode,
# for one) plans nothing. Measured live: three Karma frames whose tasks were
# seen to exit ~3s before their addOutputFile messages landed produced three
# EXRs on the volume, zero downloads and zero download work items.
#
# Holding the item back costs nothing in pod time -- the slot is released as
# soon as the task exits, only the report to PDG waits.
_RESULT_SETTLE_SECONDS = 5.0
# Longer when the item declared expected outputs (ROP Fetch does): there is
# something definite to wait for, so wait properly for it.
_RESULT_SETTLE_EXPECTED_SECONDS = 30.0

