# Dialog script for runpodfarmscheduler automatically generated

{
    name	runpodfarmscheduler
    script	runpodfarmscheduler
    label	"RunPodFarm Scheduler"

    help {
	""
    }

    group {
        name    "folder_cook"
        label   "Cook"

        parm {
            name    "rpfarm_minpods"
            label   "Min Pods"
            type    integer
            default { "1" }
            range   { 1 20 }
            help    "GPU pods created when the cook starts, and the floor the idle timeout respects while work is still queued."
        }
        parm {
            name    "rpfarm_maxpods"
            label   "Max Pods"
            type    integer
            default { "4" }
            range   { 1 50 }
            help    "Hard ceiling on GPU pods for this cook."
        }
        parm {
            name    "rpfarm_slots"
            label   "Tasks Per Pod"
            type    integer
            default { "1" }
            range   { 1 16 }
            help    "Work items one pod runs at once."
        }
        parm {
            name    "rpfarm_idletimeout"
            label   "Idle Timeout (sec)"
            type    integer
            default { "120" }
            range   { 30 600 }
            help    "Terminate a GPU pod after this many seconds with nothing to run. 0 disables it."
        }
        parm {
            name    "sepparm_budget"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "rpfarm_maxcost"
            label   "Budget ($ per cook)"
            type    float
            default { "5.0" }
            range   { 0 500 }
            help    "Warn at 80%, stop adding pods at 100%, terminate everything and fail the cook at 120%. 0 means no limit."
        }
        parm {
            name    "sepparm_outputs"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "rpfarm_downloadoutputs"
            label   "Download Outputs"
            type    toggle
            default { "1" }
            help    "Pull each work item's output files back from the volume as soon as it finishes, to the paths the ROP was aimed at."
        }
    }

    group {
        name    "folder0"
        label   "Farm"

        parm {
            name    "rpfarm_apikey"
            label   "API Key"
            type    string
            default { "" }
            help    "Leave this EMPTY: the key is read from ~/.rpfarm/config.toml (chmod 600), written by `rpfarm setup`, and Key In Use below shows which one that is. It is deliberately the one field that does not display its configured value -- a key typed here is saved into the .hip in cleartext, and that file travels to the farm and into backups. Typing one still works, and still overrides the config, if you really need a second account for one node."
        }
        parm {
            name    "rpfarm_apikeystatus"
            label   "Key In Use"
            type    string
            default { [ "hou.phm().apiKeyStatus()" python ] }
            disablewhen "{ rpfarm_verbose >= 0 }"
            help    "Read-only. Masked on purpose: enough to tell which key is in play, not enough to use it. Says NOT CONFIGURED before `rpfarm setup` has run, and warns if the API Key field above has been filled in by hand."
        }
        parm {
            name    "rpfarm_project"
            label   "Project"
            type    string
            default { [ "hou.phm().project_default()" python ] }
            help    "Project folder on the network volume: /workspace/projects/<user>/<project>. Shows the name of the $JOB directory -- what this cook will really use -- until you type your own."
        }
        parm {
            name    "rpfarm_gpulist"
            label   "GPUs To Use"
            type    string
            default { [ "hou.phm().cfg_default(\"gpu_priority\")" python ] }
            help    "The set of GPU types this cook may rent -- ANY of them, not a ranking. Add with the menu below; edit or clear the text directly to remove one. On submit the set is sorted cheapest-first and sent that way, so RunPod takes the cheapest of your choices that has capacity. Shows gpu_priority from ~/.rpfarm/config.toml, which is what this node will actually use; type your own and the literal replaces the expression and wins."
        }
        parm {
            name    "rpfarm_gpuadd"
            label   "Add A GPU"
            type    string
            default { "" }
            menu {
                [ "hou.phm().gpuMenu(kwargs)" ]
                language python
            }
            parmtag { "script_callback" "hou.phm().onAddGpu(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Pick a card to add to the set above. Houdini has no multi-select parameter, so this menu appends to that list and empties itself. A * marks one already in the set. Prices are RunPod's on-demand rate for YOUR datacenter and YOUR Cloud Type, and they match the bill to the cent (a 4090 shown at $0.74/h bills at $0.740/h). Cards with no price have no capacity there at this moment; they stay pickable because stock returns, and they are tried last. Change Datacenter or Cloud Type and the prices and the availability change with it."
        }
        parm {
            name    "rpfarm_gpuconsumer"
            label   "Only Gaming Cards In The Menu"
            type    toggle
            default { "1" }
            help    "Gaming cards (GeForce) tend to be the better value for rendering, so the menu shows only those by default. Turn this off to see the professional and datacenter cards too. It filters the MENU, never the set: anything already chosen stays visible and stays used."
        }
        parm {
            name    "rpfarm_templateid"
            label   "Template ID"
            type    string
            default { [ "hou.phm().cfg_default(\"template_id\")" python ] }
            help    "RunPod template for the pod image. Shows template_id from ~/.rpfarm/config.toml, which is what this node will actually use; type your own and the literal replaces the expression and wins. Empty means there is no config yet -- run `rpfarm setup`."
        }
        parm {
            name    "rpfarm_networkvolumeid"
            label   "Network Volume ID"
            type    string
            default { [ "hou.phm().cfg_default(\"volume_id\")" python ] }
            help    "Shared network volume mounted at /workspace on every pod. Shows volume_id from ~/.rpfarm/config.toml, which is what this node will actually use; type your own and the literal replaces the expression and wins. Empty means there is no config yet -- run `rpfarm setup`."
        }
        parm {
            name    "rpfarm_datacenter"
            label   "Datacenter"
            type    string
            default { [ "hou.phm().cfg_default(\"datacenter\")" python ] }
            menureplace {
                "EU-RO-1"   "EU Romania"
                "EU-CZ-1"   "EU Czech Republic"
                "EU-SE-1"   "EU Sweden"
                "US-TX-3"   "US Texas"
                "CA-MTL-1"  "CA Montreal"
            }
            help    "Must be the datacenter the network volume lives in -- a pod cannot mount a volume in another region. Shows datacenter from ~/.rpfarm/config.toml, which is what this node will actually use; type your own and the literal replaces the expression and wins. Empty means there is no config yet -- run `rpfarm setup`. WARNING: a scene saved before this parameter's default became an expression may carry a literal EU-RO-1 that silently overrides the config; the scheduler refuses to cook on that mismatch rather than burning pods in the wrong region."
        }
        parm {
            name    "sepparm_scaling"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "rpfarm_syncidle"
            label   "Stop Sync Pod After (min)"
            type    integer
            default { [ "hou.phm().cfg_default_int(\"sync_idle_min\", 15)" python ] }
            range   { 0 240 }
            help    "Stop -- not delete -- the shared CPU sync pod once it has gone unused this long. A stopped pod keeps its container disk and starts again in seconds, and costs about $2/month against roughly $43/month running. 0 never stops it. WORKS ONLY WHILE HOUDINI IS OPEN: the pod holds no API key and cannot retire itself, so a closed or crashed Houdini leaves it as it is; the node's Farm Status shows what is out there."
        }
        parm {
            name    "rpfarm_syncdelete"
            label   "Delete Stopped Sync Pod After (min)"
            type    integer
            default { [ "hou.phm().cfg_default_int(\"sync_delete_min\", 120)" python ] }
            range   { 0 1440 }
            help    "Delete the sync pod once it has been STOPPED this long. Stopped is cheap but not free -- RunPod bills a stopped pod's container disk at double the running rate ($0.20/GB/month against $0.10), which is about $2/month for the sync pod's 10GB. Deleting reclaims that, at the cost of a full rebuild next time instead of a few-second resume. 0 keeps it stopped indefinitely. Same limitation as above: only while Houdini is open."
        }
        parm {
            name    "rpfarm_minbalance"
            label   "Warn Below Balance ($)"
            type    float
            default { "5.0" }
            range   { 0 100 }
            help    "Warn before the cook when the RunPod account balance is below this. 0 skips the check."
        }
    }

    group {
        name    "folder_status"
        label   "Status"

        parm {
            name    "rpfarm_killsync"
            label   "Stop Everything, Sync Pod Too"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.phm().onKillAllIncludingSync(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Terminate every pod of YOURS, the CPU sync pod included, and leave the farm empty. Kill All Pods deliberately spares the sync pod because the next cook reuses it; this is the button for finishing work. It never touches another artist's pods -- the account is shared -- and it asks before killing anything that is mid-cook."
        }
        parm {
            name    "rpfarm_killall"
            label   "Kill All Pods"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.phm().onKillAll(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Terminate every rpfarm GPU pod belonging to this user, including leftovers from a crashed session. The sync pod is left alone."
        }
        parm {
            name    "rpfarm_syncledger"
            label   "Sync Ledger"
            type    button
            default { "0" }
            joinnext
            parmtag { "script_callback" "hou.phm().onSyncLedger(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Copy /workspace/ledger from the volume into ~/.rpfarm/ledger."
        }
        parm {
            name    "rpfarm_status_text"
            label   "Farm Status"
            type    string
            default { "" }
            disablewhen "{ rpfarm_verbose >= 0 }"
            parmtag { "editor" "1" }
            parmtag { "editorlines" "8-24" }
            help    "Read-only: the scheduler rewrites this while it cooks."
        }
    }

    group {
        name    "folder_volume"
        label   "Volume"

        parm {
            name    "rpfarm_volume_refresh"
            label   "Refresh"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.phm().onVolumeRefresh(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "List zones, every project's size, and total usage. Starts the sync pod if it is not up."
        }
        parm {
            name    "rpfarm_volume_target"
            label   "Target"
            type    string
            default { "" }
            help    "Project or Houdini version to delete: /workspace/projects/<user>/<project> or /workspace/houdini/<version>."
        }
        parm {
            name    "rpfarm_volume_delete"
            label   "Delete Target"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.phm().onVolumeDelete(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Permanently remove Target from the volume. Asks first. Refuses anything outside projects/ or houdini/, including ledger/ and .rpfarm/."
        }
        parm {
            name    "rpfarm_volume_growgb"
            label   "Grow By (GB)"
            type    integer
            default { "100" }
            range   { 10 2000 }
            joinnext
        }
        parm {
            name    "rpfarm_volume_grow"
            label   "Grow Volume"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.phm().onVolumeGrow(kwargs)" }
            parmtag { "script_callback_language" "python" }
            help    "Network volumes can only grow, never shrink."
        }
        parm {
            name    "rpfarm_volume_text"
            label   "Volume"
            type    string
            default { "" }
            disablewhen "{ rpfarm_verbose >= 0 }"
            parmtag { "editor" "1" }
            parmtag { "editorlines" "8-24" }
        }
    }

    group {
        name    "folder3"
        label   "Paths"

        parm {
            name    "pdg_workingdir"
            label   "Local Shared Path"
            type    string
            default { "$JOB" }
            help    "Local root of the project. PDG's temp, script and data directories live under it, and it is the local half of the path map."
        }
        parm {
            name    "pdg_workitemdatasource"
            label   "Load Item Data From"
            type    ordinal
            default { "1" }
            menu {
                "0" "Temporary JSON File"
                "1" "RPC Message"
            }
            help    "RPC Message fetches each item's data over the MQ, so no per-item file has to be copied to the farm. Temporary JSON File uploads one file per item instead."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_deletetempdir"
            label   "Delete Temp Dir"
            type    ordinal
            default { "0" }
            menu {
                "0" "Never"
                "1" "When Scheduler is Deleted"
                "2" "When Cook Completes"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_compressworkitemdata"
            label   "Compress Work Item Data"
            type    toggle
            default { "1" }
            disablewhen "{ pdg_workitemdatasource == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_validateoutputs"
            label   "Validate Outputs When Recooking"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_checkexpectedoutputs"
            label   "Check Expected Outputs on Disk"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "pdg_mapmode"
            label   "Path Mapping"
            type    ordinal
            default { "0" }
            menu {
                "0" "Global"
                "1" "None"
            }
            help    "Global lets the scheduler register $JOB <-> /workspace/projects/<user>/<project> for the cook. None turns path mapping off entirely."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_usemapzone"
            label   "Zone"
            type    toggle
            nolabel
            joinnext
            default { "0" }
            disablewhen "{ pdg_mapmode == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_mapzone"
            label   "Path Map Zone"
            type    string
            default { "$PDG_PATHMAP_ZONE" }
            disablewhen "{ pdg_usemapzone == 0 }"
            menureplace {
                "LINUX" "LINUX"
                "WIN"   "WIN"
                "MAC"   "MAC"
            }
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "folder_advanced"
        label   "Advanced"

        parm {
            name    "rpfarm_verbose"
            label   "Verbose Logging"
            type    toggle
            default { "0" }
        }
        parm {
            name    "rpfarm_capacitywait"
            label   "Wait For Capacity (min)"
            type    integer
            default { [ "hou.phm().cfg_default_int(\"capacity_wait_min\", 15)" python ] }
            range   { 0 120 }
            help    "How long a work item waits for a free machine before that ONE item fails. RunPod pods are not spot instances -- a pod you already have is never taken away -- so a shortage is a queue, not an eviction, and the cook waits instead of dying. Past this deadline only the items still waiting are failed, so a re-cook retries just those and the rest of the graph keeps what it computed. 0 waits forever. Shows capacity_wait_min from ~/.rpfarm/config.toml, which is what this node will actually use; type your own and the literal replaces the expression and wins."
        }
        parm {
            name    "rpfarm_cloudtype"
            label   "Cloud Type"
            type    string
            default { [ "hou.phm().cfg_default(\"cloud_type\", \"SECURE\")" python ] }
            menureplace {
                "SECURE"    "Secure (vetted datacentres)"
                "COMMUNITY" "Community (cheaper, often has machines when Secure is empty)"
            }
            help    "Which RunPod capacity pool to rent from. This only means anything together with Datacenter: a cloud can be completely empty in one region and full in another. In EU-RO-1 as measured, Community had 0 of 48 GPU types available while Secure had 9, so switching there is not a fix for a shortage in that region -- check the prices in the Add A GPU menu, which follow this setting. Shows cloud_type from ~/.rpfarm/config.toml; type your own and the literal replaces the expression and wins."
        }
        groupsimple {
            name    "folder_adv_remote"
            label   "Remote Shared Path"

            parm {
                name    "rpfarm_overrideremoteworkingdir"
                label   "Override Remote Shared Path"
                type    toggle
                nolabel
                joinnext
                default { "0" }
            }
            parm {
                name    "rpfarm_remoteworkingdir"
                label   "Remote Shared Path"
                type    string
                default { "" }
                disablewhen "{ rpfarm_overrideremoteworkingdir == 0 }"
                help    "Defaults to /workspace/projects/<user>/<project> on the volume."
            }
        }

        groupsimple {
            name    "folder7_cmds"
            label   "Commands"

            parm {
                name    "rpfarm_pretaskcmd"
                label   "Pre Task Command"
                type    string
                default { "" }
                parmtag { "pdg::scheduler" "" }
            }
            parm {
                name    "rpfarm_posttaskcmd"
                label   "Post Task Command"
                type    string
                default { "" }
                parmtag { "pdg::scheduler" "" }
            }
        }

        groupsimple {
            name    "folder7_env"
            label   "Task Environment"

            parm {
                name    "rpfarm_inheritlocalenv"
                label   "Inherit Local Environment"
                type    toggle
                default { "0" }
                parmtag { "pdg::scheduler" "" }
            }
            parm {
                name    "rpfarm_envunset"
                label   "Unset Variables"
                type    string
                default { "" }
                parmtag { "pdg::scheduler" "" }
                parmtag { "script_callback_language" "python" }
            }
            multiparm {
                name    "rpfarm_envmulti"
                label    "Environment Variables"

                parm {
                    name    "rpfarm_envname#"
                    label   "Name"
                    type    string
                    default { "" }
                    parmtag { "pdg::nocopy" "" }
                    parmtag { "pdg::scheduler" "" }
                }
                parm {
                    name    "rpfarm_envvalue#"
                    label   "Value"
                    type    string
                    default { "" }
                    parmtag { "pdg::nocopy" "" }
                    parmtag { "pdg::scheduler" "" }
                }
            }

            parm {
                name    "rpfarm_usehoudinimaxthreads"
                label   "Use Max Threads"
                type    toggle
                nolabel
                joinnext
                default { "0" }
                parmtag { "pdg::scheduler" "" }
            }
            parm {
                name    "rpfarm_houdinimaxthreads"
                label   "Max Threads"
                type    integer
                default { "0" }
                disablewhen "{ rpfarm_usehoudinimaxthreads == 0 }"
                range   { 0 10 }
                parmtag { "pdg::scheduler" "" }
            }
        }
    }

    group {
        name    "folder4"
        label   "Submit As Job"

        parm {
            name    "submitjob"
            label   "Submit"
            type    button
            default { "0" }
            parmtag { "script_callback" "hou.pwd().hm().submitGraphAsJob(kwargs, hou.pwd())" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "usesubmitjobnode"
            label   "Use Output Node"
            type    toggle
            nolabel
            joinnext
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "submitjobnode"
            label   "Output Node"
            type    oppath
            default { "" }
            disablewhen "{ usesubmitjobnode == 0 }"
            parmtag { "opfilter" "!!TOP!!" }
            parmtag { "oprelative" "." }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "submitjobfile"
            label   "Save Task Graph File"
            type    toggle
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "folder5"
        label   "Message Queue"

        parm {
            name    "mqusage"
            label   "Type"
            type    integer
            default { "0" }
            menu {
                "0" "Farm"
                "1" "Local"
                "2" "Connect"
            }
            range   { 0 10 }
            help    "Farm runs mqserver on the sync pod and is the only mode the render pods can reach. Local only works if this machine is reachable from RunPod."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "mqaddr"
            label   "Address"
            type    string
            default { "" }
            disablewhen "{ mqusage != 2 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "usetaskcallbackport"
            label   "usetaskcallbackport"
            type    toggle
            nolabel
            joinnext
            default { "0" }
            disablewhen "{ mqusage == 2 }"
        }
        parm {
            name    "taskcallbackport"
            label   "Task Callback Port"
            type    integer
            default { "1024" }
            disablewhen "{ usetaskcallbackport == 0 mqusage != 2 }"
            range   { 0 65535 }
        }
        parm {
            name    "usemqrelayport"
            label   "usemqrelayport"
            type    toggle
            nolabel
            joinnext
            default { "0" }
            disablewhen "{ mqusage == 2 }"
        }
        parm {
            name    "mqrelayport"
            label   "Relay Port"
            type    integer
            default { "1025" }
            disablewhen "{ usemqrelayport == 0 mqusage != 2 }"
            range   { 1024 49151 }
        }
    }

    group {
        name    "folder6"
        label   "RPC Server"

        parm {
            name    "pdg_rpcignoreerrors"
            label   "Ignore RPC Errors"
            type    ordinal
            default { "1" }
            menu {
                "0" "Never"
                "1" "When Cooking Batches"
                "2" "Always"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpcmaxerrors"
            label   "Max RPC Errors"
            type    integer
            default { "5" }
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpctimeout"
            label   "Connection Timeout"
            type    integer
            default { "4" }
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpcretries"
            label   "Connection Retries"
            type    integer
            default { "2" }
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpcbackoff"
            label   "Retry Backoff"
            type    integer
            default { "2" }
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpcbatch"
            label   "Batch Poll Rate"
            type    float
            default { "1" }
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "pdg_rpcrelease"
            label   "Release Job Slot When Polling"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
    }
}
