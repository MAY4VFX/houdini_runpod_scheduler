# Dialog script for runpodfarmupload automatically generated

{
    name	runpodfarmupload
    script	runpodfarmupload
    label	"RunPodFarm Upload"

    help {
    }

    inputlabel	1	"Input 1"
    inputlabel	2	"Input 2"
    inputlabel	3	"Input 3"
    inputlabel	4	"Input 4"

    parm {
        name    "rpfarm_mode"
        label   "Mode"
        type    string
        default { "deps" }
        help    "Project dependencies: hou.fileReferences() plus the hip file itself. Custom paths: exactly the local -> remote pairs below."
        menu {
            "deps"      "Project Dependencies"
            "custom"    "Custom Paths"
        }
    }
    parm {
        name    "rpfarm_scope"
        label   "Dependencies"
        type    string
        default { "branch" }
        help    "Branch: only what the ROPs this TOP network fetches actually read. Whole scene: every file reference in the hip file. Neither can see assets a USD layer references from inside itself -- those never appear in hou.fileReferences() in the first place."
        hidewhen "{ rpfarm_mode != deps }"
        menu {
            "branch"    "This cook's branch"
            "scene"     "Whole scene"
        }
    }
    parm {
        name    "rpfarm_project"
        label   "Project"
        type    string
        default { [ "hou.phm().project_default()" python ] }
        help    "Project folder on the network volume: /workspace/projects/<user>/<project>. Shows the name of the $JOB directory until you type your own."
    }
    parm {
        name    "rpfarm_packagegb"
        label   "Package Size (GB)"
        type    float
        default { "1.5" }
        help    "Files are grouped into work items no larger than this (a single bigger file still gets its own item)."
        range   { 0.1 16 }
    }
    parm {
        name    "rpfarm_compress"
        label   "Compression"
        type    string
        default { "auto" }
        help    "auto compresses by default (Ruling R23: no live uplink measurement exists yet -- `rpfarm doctor` will supply one in Task 13, at which point auto starts actually comparing it against 200 Mbps instead of always compressing)."
        menu {
            "auto"  "Auto"
            "on"    "On"
            "off"   "Off"
        }
    }
    parm {
        name    "rpfarm_confirm"
        label   "Confirm Before Upload"
        type    toggle
        default { "1" }
        help    "Show the plan -- every reference with its size, heaviest first -- and upload only what stays checked. Off for batch/headless cooks, which then use the selection this node already remembers. A cook with no UI (hython) never shows the window regardless."
        hidewhen "{ rpfarm_mode != deps }"
    }
    parm {
        name    "rpfarm_usddeep"
        label   "Scan USD Layer Files Too"
        type    toggle
        default { "1" }
        help    "On: also run UsdUtils.ComputeAllDependencies on every USD layer on disk, which finds what the layer file references even when this session never composed it -- and expands <UDIM> itself. Off: only what the live stage reads. 0.02s per layer on a 1.6 GB layer, but reported slow on very large scenes; the cook logs the time it took."
        hidewhen "{ rpfarm_mode != deps }"
    }
    parm {
        name    "rpfarm_preview"
        label   "Preview Upload..."
        type    button
        default { "0" }
        help    "Open that window now, without cooking. This is how you set the selection for a batch cook that will never open it."
        hidewhen "{ rpfarm_mode != deps }"
        parmtag { "script_callback" "hou.phm().previewUpload(kwargs)" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "rpfarm_clearexclude"
        label   "Re-check Everything"
        type    button
        default { "0" }
        help    "Forget every reference unchecked in the window."
        hidewhen "{ rpfarm_mode != deps }"
        parmtag { "script_callback" "hou.phm().clearExclusions(kwargs)" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "rpfarm_exclude"
        label   "Unchecked USD Files"
        type    string
        invisible
        default { "" }
        help    "JSON list of USD files the artist unchecked. Cleared by Re-check Everything."
    }
    multiparm {
        name    "rpfarm_custom"
        label    "Custom Paths"
        default 0

        parm {
            name    "rpfarm_local#"
            label   "Local"
            type    file
            default { "" }
        }
        parm {
            name    "rpfarm_remote#"
            label   "Remote"
            type    string
            default { "" }
        }
    }

    parm {
        name    "rpfarm_postcmd"
        label   "Post-command"
        type    string
        default { "" }
        help    "Shell command run on the sync pod once, after every package in this cook has uploaded. Ignored when empty."
    }
    parm {
        name    "rpfarm_preset"
        label   "Preset"
        type    string
        default { "none" }
        help    "Install Houdini from tarball computes Custom Paths + Post-command from the two fields below at generate time."
        menu {
            "none"              "None"
            "install_houdini"   "Install Houdini from tarball"
        }
    }
    parm {
        name    "rpfarm_houtar"
        label   "Houdini Tarball"
        type    file
        default { "" }
        help    "Local path to houdini-<version>-linux_x86_64_gcc14.2.tar.gz."
        hidewhen "{ rpfarm_preset != install_houdini }"
    }
    parm {
        name    "rpfarm_houver"
        label   "Houdini Version"
        type    string
        default { [ "hou.phm().cfg_default(\"houdini_version\")" python ] }
        help    "Shows houdini_version from ~/.rpfarm/config.toml -- the version the farm pods run. Type your own to install a different one. Empty means there is no config yet: run `rpfarm setup`."
        hidewhen "{ rpfarm_preset != install_houdini }"
    }
    parm {
        name    "rpfarm_inprocess"
        label   "Cook In Process (debug)"
        type    toggle
        default { "0" }
        help    "Off (default): packages upload out of process, in parallel, without blocking Houdini. On: cook in this Houdini session instead -- blocks the UI, one package at a time, useful for debugging."
    }
}
